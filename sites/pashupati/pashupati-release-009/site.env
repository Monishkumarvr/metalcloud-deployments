# Pashupati site configuration (no secrets: those are in the Device's
# persistent/secrets/pashupati.env).

# AGNI API
AGNI_API_URL=http://ai-bakend-v2.ap-south-1.elasticbeanstalk.com/api/v1
AGNI_ENDPOINT=/agni
AGNI_CUSTOMER_ID=237
AGNI_CAMERA_ID=ch7
# Two furnaces on ch7 (Release 003): the centre zones are Furnace 2, the right ones
# Furnace 1. Each furnace has its own tap-to-tap chain; heat numbers are shared.
AGNI_ZONE_FURNACES=Furnace_1_Tapping_Zone=Furnace1,Furnace_1_Deslagging_Zone=Furnace1,Furnace_1_Melting_Zone=Furnace1,Furnace_2_Tapping_Zone=Furnace2,Furnace_2_Deslagging_Zone=Furnace2,Furnace_2_Melting_Zone=Furnace2
AGNI_FURNACE_LOCATIONS=Furnace1=Furnace 1,Furnace2=Furnace 2
# Furnace of Release 002 heats (one centre zone) and of unmapped zones.
AGNI_FURNACE=Furnace2
AGNI_LOCATION=Furnace 2
# sync_id = <prefix>-<furnace>-<first tapping start epoch>. Release 007 rebuilds every heat
# from HEAT_0001 under a new prefix and a new state folder (/data/agni is kept as it was).
AGNI_SYNC_PREFIX=pashupati2
STATE_DIR=/data/agni-v2
# 1 = write payloads to STATE_DIR/dry_run instead of posting. Release 008 posts for real.
SYNC_DRY_RUN=0

# Heats: tapping pieces less than JOIN_GAP_S apart are one heat; a heat is closed
# JOIN_GAP_S after its last piece once tapping is idle, or after MAX_HEAT_WAIT_S.
JOIN_GAP_S=60
# Tapping pieces of one heat at most this many seconds apart are posted as one tapping
# event (one pour cut into pieces by brightness dips and the 10 s cooldown). 60 = JOIN_GAP_S:
# every heat posts one tapping event. 0 = post every piece.
TAPPING_MERGE_GAP_S=60
# Tapping pieces shorter than this are ignored for heats (matches the tapping module's 5 s minimum).
MIN_TAPPING_PIECE_S=5
MAX_HEAT_WAIT_S=1800

# Only a pour counts (2026-10-22 RCA on NVR footage):
# - only while its furnace is melting (melting module; an idle furnace's sunlit or lamp-lit ladle is not);
# - no piece longer than TAPPING_MAX_PIECE_S (preheat fires and furnace flames burn 15-30 min);
# - a group of pieces spans at least TAPPING_MIN_SPAN_S (flares last 8-49 s) and peaks at
#   TAPPING_MIN_PEAK_RATIO or more (lit empty ladles peak at 0.33-0.56, pours at 0.77-1.0).
AGNI_MELTING_GATE=1
TAPPING_MAX_PIECE_S=300
TAPPING_MIN_SPAN_S=60
TAPPING_MIN_PEAK_RATIO=0.6
# A heat starts 1 s after the previous heat's last tapping end; after HEAT_IDLE_GAP_S without
# a heat (or for a furnace's first heat) it starts when the furnace started melting, at most
# MAX_HEAT_OPEN_S before the tap.
HEAT_IDLE_GAP_S=10800
MAX_HEAT_OPEN_S=21600

# History rebuild (Release 007): Release 001 tapping (5-9 Oct, confirmed false) is ignored;
# events before Release 003 came from the one centre zone (Furnace 2); the 2 Oct test run,
# melting starts found on footage and confirmed false windows come from the rebuild file.
AGNI_IGNORE_TAPPING_BEFORE=2026-10-09T19:45:00+05:30
AGNI_LEGACY_BEFORE=2026-10-14T16:21:00+05:30
AGNI_REBUILD_FILE=/release/config/agni_rebuild.json
# Shifts in site local time (Day 06-18, Night 18-06, as in the AGNI shifts collection). The
# first shift listed starts the heat's `date`: starting at 00 keeps the calendar date in IST.
AGNI_SHIFTS=Night=00-06,Day=06-18,Night=18-24
SITE_UTC_OFFSET=+05:30
RETENTION_DAYS=30

# Camera (NVR channel 7 main stream) and output
SOURCE_WIDTH=2880
SOURCE_HEIGHT=1620
SOURCE_FPS=25
# Processing canvas (streammux): tapping geometry is specified at 1920x1080.
OUTPUT_WIDTH=1920
OUTPUT_HEIGHT=1080
# headless: the live inference tab is the only view. rtsp: also serve the annotated
# view over RTSP, on port RTSP_OUT_PORT at the path RTSP_OUT_MOUNT (25 fps H.264).
OPSIS_VIDEO_MODE=headless

# Live inference tab frame rate, up to the camera's 25 (0 = off)
LIVE_FPS=25
# Live inference tab picture size (scaled from the processing canvas)
LIVE_WIDTH=1280
LIVE_HEIGHT=720
LIVE_JPEG_QUALITY=60
