# Pashupati site configuration (no secrets: those are in the Device's
# persistent/secrets/pashupati.env).

# AGNI API
AGNI_API_URL=http://ai-bakend-v2.ap-south-1.elasticbeanstalk.com/api/v1
AGNI_ENDPOINT=/agni
AGNI_CUSTOMER_ID=237
AGNI_CAMERA_ID=ch7
# Two furnaces on ch7 (Release 003): the centre zones are Furnace 2, the right ones
# Furnace 1. Each furnace has its own tap-to-tap chain; heat numbers are shared.
AGNI_ZONE_FURNACES=Furnace_1_Tapping_Zone=Furnace1,Furnace_1_Deslagging_Zone=Furnace1,Furnace_2_Tapping_Zone=Furnace2,Furnace_2_Deslagging_Zone=Furnace2
AGNI_FURNACE_LOCATIONS=Furnace1=Furnace 1,Furnace2=Furnace 2
# Furnace of Release 002 heats (one centre zone) and of unmapped zones.
AGNI_FURNACE=Furnace2
AGNI_LOCATION=Furnace 2
# sync_id = <prefix>-<furnace>-<first tapping start epoch>
AGNI_SYNC_PREFIX=pashupati
# 1 = write payloads to /data/agni/dry_run instead of posting
SYNC_DRY_RUN=0

# Heats: tapping pieces less than JOIN_GAP_S apart are one heat; a heat is closed
# JOIN_GAP_S after its last piece once tapping is idle, or after MAX_HEAT_WAIT_S.
JOIN_GAP_S=60
# Tapping pieces of one heat at most this many seconds apart are posted as one tapping
# event (one pour cut into pieces by brightness dips and the 10 s cooldown). 60 = JOIN_GAP_S:
# every heat posts one tapping event. 0 = post every piece.
TAPPING_MERGE_GAP_S=60
# Tapping pieces shorter than this are ignored for heats (matches the tapping module's 5 s minimum).
MIN_TAPPING_PIECE_S=5
MAX_HEAT_WAIT_S=1800
# Shifts in site local time. The first shift listed starts the heat's `date`: C (00-08)
# first makes it the calendar date in IST, so heats after midnight carry the new date.
AGNI_SHIFTS=C=00-08,A=08-16,B=16-24
SITE_UTC_OFFSET=+05:30
RETENTION_DAYS=30

# Camera (NVR channel 7 main stream) and output
SOURCE_WIDTH=2880
SOURCE_HEIGHT=1620
SOURCE_FPS=25
# Processing canvas (streammux): tapping geometry is specified at 1920x1080.
OUTPUT_WIDTH=1920
OUTPUT_HEIGHT=1080
# headless: the live inference tab is the only view. rtsp: also serve the annotated
# view over RTSP, on port RTSP_OUT_PORT at the path RTSP_OUT_MOUNT (25 fps H.264).
OPSIS_VIDEO_MODE=headless

# Live inference tab frame rate, up to the camera's 25 (0 = off)
LIVE_FPS=25
# Live inference tab picture size (scaled from the processing canvas)
LIVE_WIDTH=1280
LIVE_HEIGHT=720
LIVE_JPEG_QUALITY=60
