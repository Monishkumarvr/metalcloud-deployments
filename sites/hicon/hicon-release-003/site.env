# HiCon release 001: the non-secret keys of the device .env as of 2026-10-23 (exactly what ran natively).
# Secrets (camera URLs, API URLs, HMAC, Sentry) live on the Device in persistent/secrets/hicon.env.
# IST as a POSIX TZ string (as Nipha): the app stamps events with datetime.now(), and the
# container is UTC without it. Works without tzdata and without bind-mounting /etc/localtime.
TZ=IST-5:30
HICON_USE_NVURISRCBIN_0=true
HICON_USE_NVURISRCBIN_1=true
HICON_USE_NVURISRCBIN_2=true
HICON_RTSP_PROTOCOL_0=tcp
HICON_RTSP_PROTOCOL_1=tcp
HICON_RTSP_PROTOCOL_2=tcp
HICON_RTSP_CODEC_0=h265
HICON_RTSP_CODEC_1=h265
HICON_RTSP_CODEC_2=h265
HICON_STREAM_0_MUX_WIDTH=1600
HICON_STREAM_0_MUX_HEIGHT=900
HICON_STREAM_0_ZERO_FPS_POLICY=warn
HICON_STREAM_1_ZERO_FPS_POLICY=restart
HICON_STREAM_2_ZERO_FPS_POLICY=restart
HICON_ENABLE_DEBUG_PROBES=true
HICON_USE_CUDA_BRIGHTNESS=false
HICON_ENABLE_STREAM_0_PROBE=true
HICON_ENABLE_STREAM_0_POURING_PROCESSOR=true
HICON_ENABLE_STREAM_0_BRIGHTNESS_PROCESSOR=true
HICON_CUSTOMER_ID=1157
HICON_DEVICE_ID=DEVICE001
HICON_ENABLE_SYNC=true
HICON_ENABLE_LIVE_STREAM=true
HICON_ENABLE_STREAM0_LOCAL_RELAY=false
HICON_ENABLE_STREAM1_LOCAL_RELAY=true
HICON_ENABLE_STREAM2_LOCAL_RELAY=true
HICON_LIVE_STREAM_HOST=0.0.0.0
HICON_LIVE_STREAM_PORT=8080
HICON_LIVE_STREAM_QUALITY=75
HICON_LIVE_STREAM_FPS=10
HICON_LIVE_STREAM_DEMAND_DRIVEN=true
HICON_LIVE_STREAM_IDLE_GRACE_SEC=5
HICON_SAVE_RAW_SCREENSHOTS=false
HICON_SCREENSHOT_MAX_WIDTH=1280
HICON_SCREENSHOT_JPEG_QUALITY=75
HICON_MOULD_GIE_ENABLED=true
HICON_MOULD_GIE_INTERVAL=7
HICON_MOULD_COUNT_MODE=tracker
HICON_MOULD_CANONICAL_ENABLED=true
HICON_MOULD_DIAG_CSV=true
HICON_STREAM0_TRACKER_MAX_TARGETS=64
HICON_ENABLE_INFERENCE_VIDEO=false
HICON_INFERENCE_VIDEO_SCHEDULE=always
HICON_INFERENCE_VIDEO_MAX_DURATION_S=3600
HICON_INFERENCE_VIDEO_RETENTION_DAYS=3
HICON_LOG_MOULD_DISPLACEMENT=false
