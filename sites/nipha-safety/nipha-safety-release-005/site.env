# Nipha safety (site nipha-safety): non-secret settings, shipped with the Release.
# Secrets (NIPHA_HMAC_SECRET) live only in the Device's persistent/secrets/nipha-safety.env;
# camera URLs only in persistent/secrets/mediamtx.yml.

# Backend
NIPHA_CUSTOMER_ID=104
SAFETY_API_URL=http://ai-bakend-v2.ap-south-1.elasticbeanstalk.com/api/v1
SAFETY_ENDPOINT=/safety
SAFETY_CAMERAS=F12,F34,F56
SAFETY_LOCATIONS=F12=Furnace A-B,F34=Furnace C-D,F56=Furnace E-F
SITE_UTC_OFFSET=+05:30
# 1 = build and log items only (persistent/database/sync/dry_run_items.jsonl), send nothing.
# Live from release 003 (2026-10-28): every pending violation is sent, oldest first.
SYNC_DRY_RUN=0
SYNC_INTERVAL_S=30
SYNC_CHUNK_SIZE=2
RETENTION_DAYS=7

# PPE app (apps/nipha_ppe), release 005: safety_nano_nipha_v1 (YOLO26n) at 1280x736 FP16 on an
# 8 GB Orin NX at 20 W, 3 cameras. 16 ms per frame: 25 fps cameras, 1 of every 2 frames ->
# 12.5 fps per camera (~62% GPU). PPE timers use the wall clock.
NIPHA_FRAME_INTERVAL=2
NIPHA_RTSP_TCP=1
NIPHA_SAVE_VIDEO=0
NIPHA_STALL_TIMEOUT_S=60
NIPHA_STARTUP_GRACE_S=240
DB_RETENTION_DAYS=7

# Detection thresholds (nvinfer pre-cluster-threshold), applied at container start by
# docker/render_pgie_config.py. Changing them needs only a new Release with a new site.env.
NIPHA_PERSON_THRESHOLD=0.60
# 0.10 (release 005): weak helmets reach the app; only >= NIPHA_PPE_HELMET_VETO_CONF can veto
NIPHA_HELMET_THRESHOLD=0.10

# Tracker: OC-SORT, config /release/config/tracker_ocsort.yml (release 005: tuned for 12.5 fps).
NIPHA_TRACKER=ocsort

# Precision first: a missed real violation is acceptable, a false one is not.
# Release 005: a helmet >= 0.20 seen on the person at ANY point of the 10 s violation window
# vetoes it (no screenshot, no row); 0.30+ is helmet evidence. 0.10 vetoed real cloth-covered
# heads on the F56 replay, 0.20 did not and still caught no false violation.
NIPHA_PPE_HELMET_CONF=0.30
NIPHA_PPE_HELMET_VETO_CONF=0.20
NIPHA_PPE_VETO_LOOKBACK_S=10
# Persons the helmet read can't be trusted on are ignored (1920x1080 canvas px).
NIPHA_PPE_PERSON_CONF=0.70
NIPHA_PPE_MIN_PERSON_HEIGHT_PX=150
NIPHA_PPE_EDGE_MARGIN_PX=8
# One person's repeat within 120 s is merged even after a tracker ID switch.
NIPHA_PPE_INCIDENT_MAX_CENTER_DISTANCE_PX=900
# Spec values (release 005, Nano at 12.5 fps). Release 004 used 15 / 0 / 30 s only to
# compensate for YOLO26x at ~1.7 fps.
NIPHA_PPE_NO_HELMET_CONFIRM_S=10
NIPHA_PPE_HELMET_MEMORY_CONFIRM_S=1
NIPHA_PPE_RECENT_HELMET_GRACE_S=10
