# Steelcast Release 001 operational flags, from the device's ai_vision/.env
# (2026-10-08). No secrets: those live on the Device in
# /opt/metalcloud/persistent/secrets/steelcast.env (keys: STEELCAST_HMAC_SECRET,
# STEELCAST_SENTRY_DSN, STEELCAST_HC_UUID, STEELCAST_THINGSBOARD_URL).
# Modules run per camera from configs/streams.json in the image: helmet/PPE,
# heat start, deslagging and pyrometer on furnace-side; ladle preheat on
# ladle-preheat; tapping and thermal deslagging on pouring.

STEELCAST_CUSTOMER_ID=1247
STEELCAST_LOCATION=Steelcast Plant
STEELCAST_ENABLE_SYNC=true
STEELCAST_API_URL=http://ai-bakend-v2.ap-south-1.elasticbeanstalk.com/api/v1
STEELCAST_AGNI_ENDPOINT=/agni
STEELCAST_SENTRY_ENV=production
STEELCAST_THINGSBOARD_INTERVAL_S=60

# Live tab
STEELCAST_ENABLE_LIVE_STREAM=true
STEELCAST_LIVE_STREAM_PORT=8080
STEELCAST_LIVE_STREAM_FPS=5
STEELCAST_LIVE_STREAM_QUALITY=70
STEELCAST_LIVE_TAB_DIR=/app/live-inference-tab

# State, sync and screenshots (paths inside the container, on Persistent data)
STEELCAST_DB_PATH=/app/ai_vision/state/steelcast.db
STEELCAST_DB_RETENTION_DAYS=7
STEELCAST_SYNC_BATCH_SIZE=50
STEELCAST_SYNC_INTERVAL_S=30
STEELCAST_SCREENSHOT_DIR=/app/ai_vision/output/screenshots
STEELCAST_SCREENSHOT_MAX_WIDTH=1280
STEELCAST_SCREENSHOT_JPEG_QUALITY=75

# Streams
STEELCAST_STALL_TIMEOUT_S=60
STEELCAST_USE_NVURISRCBIN=true
STEELCAST_RTSP_RECONNECT_INTERVAL_SECONDS=10
STEELCAST_RTSP_RECONNECT_ATTEMPTS=-1
STEELCAST_RTSP_LATENCY_MS=300
STEELCAST_RTSP_FORCE_TCP=true
STEELCAST_RTSP_DECODER_EXTRA_SURFACES=1
STEELCAST_SURFACE_EVERY_N=2

# Engines and diagnostics
STEELCAST_VALIDATE_TRT_ENGINES=true
STEELCAST_LOG_DETECTIONS=true
STEELCAST_LOG_DETECTIONS_INTERVAL_S=2
STEELCAST_LOG_EVENT_GATES=true
STEELCAST_ENABLE_OSD=true
STEELCAST_OSD_DISPLAY_BBOX=true
STEELCAST_OSD_DISPLAY_TEXT=true
