# Mantri Release A operational flags. No secrets: those live on the Device in
# /opt/metalcloud/persistent/secrets/mantri.env (keys: MANTRI_HMAC_SECRET,
# MANTRI_SENTRY_DSN, MANTRI_HC_UUID, MANTRI_THINGSBOARD_URL).

# Modules
MANTRI_MONOTRACK_ENABLED=true
MANTRI_INOCULATION_ENABLED=true
MANTRI_SPECTRO_ENABLED=true
MANTRI_INOCULATION_LOG_DETECTIONS_INTERVAL_S=5

# From the production compose file (2026-09-24)
MANTRI_TRACKER_WIDTH=640
MANTRI_TRACKER_HEIGHT=384
MANTRI_MONOTRACK_INTERVAL=1
MANTRI_SHARED_DECODE=0
MANTRI_EXIT_ON_ALL_STREAMS_STALE=false
MANTRI_ALL_STREAMS_STALE_EXIT_S=180
MANTRI_HEALTH_LOG_MAX_STALE_SECONDS=90
MANTRI_HEALTH_REQUIRE_LOG_FRESH=false
MANTRI_HEALTH_STATUS_MAX_FRAME_AGE_S=90
MANTRI_LOG_MAX_BYTES=52428800
MANTRI_LOG_BACKUP_COUNT=5
MANTRI_FORCE_SENTRY=true

# Paths inside the container, all under Persistent data or the image
MANTRI_DB_PATH=/app/ai_vision/state/mantri.db
MANTRI_SCREENSHOT_DIR=/app/ai_vision/output/screenshots
MANTRI_LIVE_TAB_DIR=/app/live-inference-tab

# From Mantri's ai_vision/.env (2026-09-24)
MANTRI_MONOTRACK_LOG_DETECTIONS_INTERVAL_S=10
MANTRI_CUSTOMER_ID=634
MANTRI_LOCATION=mantri
MANTRI_ENABLE_SYNC=true
MANTRI_API_URL=http://ai-bakend-v2.ap-south-1.elasticbeanstalk.com/api/v1
MANTRI_EVENTS_ENDPOINT=/events
MANTRI_AGNI_ENDPOINT=/agni
MANTRI_SENTRY_ENV=production
MANTRI_THINGSBOARD_INTERVAL_S=60
MANTRI_THINGSBOARD_TIMEOUT_S=10
MANTRI_ENABLE_LIVE_STREAM=true
MANTRI_LIVE_STREAM_PORT=8080
MANTRI_LIVE_STREAM_FPS=5
MANTRI_LIVE_STREAM_QUALITY=70
# Event rows are never deleted; only synced screenshots older than this are.
MANTRI_SCREENSHOT_RETENTION_DAYS=7
MANTRI_SYNC_BATCH_SIZE=50
MANTRI_SYNC_INTERVAL_S=30
MANTRI_STALL_TIMEOUT_S=60
MANTRI_SCREENSHOT_MAX_WIDTH=768
MANTRI_SCREENSHOT_JPEG_QUALITY=75
MANTRI_VALIDATE_TRT_ENGINES=true
MANTRI_SURFACE_EVERY_N=2
MANTRI_LOG_DETECTIONS=true
MANTRI_LOG_DETECTIONS_INTERVAL_S=2
MANTRI_LOG_EVENT_GATES=false
