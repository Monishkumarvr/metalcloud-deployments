# Mantri Release A operational flags. No secrets: those live on the Device in
# /opt/metalcloud/persistent/secrets/mantri.env (keys: MANTRI_HMAC_SECRET,
# MANTRI_SENTRY_DSN, MANTRI_HC_UUID, MANTRI_THINGSBOARD_URL, MANTRI_SLACK_WEBHOOK_URL).

# Modules
MANTRI_MONOTRACK_ENABLED=true
MANTRI_INOCULATION_ENABLED=true
MANTRI_SPECTRO_ENABLED=true
MANTRI_INOCULATION_LOG_DETECTIONS_INTERVAL_S=30

# From the production compose file (2026-09-24)
MANTRI_TRACKER_WIDTH=640
MANTRI_TRACKER_HEIGHT=384
# Release R-002: infer every kept frame (drop 2 -> 12.5 fps), was 1 (6.25 fps)
MANTRI_MONOTRACK_INTERVAL=0
MANTRI_SHARED_DECODE=0
MANTRI_EXIT_ON_ALL_STREAMS_STALE=false
MANTRI_ALL_STREAMS_STALE_EXIT_S=180
MANTRI_HEALTH_LOG_MAX_STALE_SECONDS=90
MANTRI_HEALTH_REQUIRE_LOG_FRESH=false
MANTRI_HEALTH_STATUS_MAX_FRAME_AGE_S=90
MANTRI_LOG_MAX_BYTES=52428800
MANTRI_LOG_BACKUP_COUNT=5
MANTRI_FORCE_SENTRY=true

# Paths inside the container, all under Persistent data or the image
MANTRI_DB_PATH=/app/ai_vision/state/mantri.db
MANTRI_SCREENSHOT_DIR=/app/ai_vision/output/screenshots
MANTRI_LIVE_TAB_DIR=/app/live-inference-tab

# From Mantri's ai_vision/.env (2026-09-24)
MANTRI_MONOTRACK_LOG_DETECTIONS_INTERVAL_S=30
MANTRI_CUSTOMER_ID=634
MANTRI_LOCATION=mantri
MANTRI_ENABLE_SYNC=true
MANTRI_API_URL=http://ai-bakend-v2.ap-south-1.elasticbeanstalk.com/api/v1
MANTRI_EVENTS_ENDPOINT=/events
MANTRI_AGNI_ENDPOINT=/agni
MANTRI_SENTRY_ENV=production
MANTRI_THINGSBOARD_INTERVAL_S=60
MANTRI_THINGSBOARD_TIMEOUT_S=10
MANTRI_ENABLE_LIVE_STREAM=true
MANTRI_LIVE_STREAM_PORT=8080
MANTRI_LIVE_STREAM_FPS=5
MANTRI_LIVE_STREAM_QUALITY=70
# Event rows are never deleted; only synced screenshots older than this are.
MANTRI_SCREENSHOT_RETENTION_DAYS=7
MANTRI_SYNC_BATCH_SIZE=50
MANTRI_SYNC_INTERVAL_S=30
MANTRI_STALL_TIMEOUT_S=60
MANTRI_SCREENSHOT_MAX_WIDTH=768
MANTRI_SCREENSHOT_JPEG_QUALITY=75
MANTRI_VALIDATE_TRT_ENGINES=false
MANTRI_SURFACE_EVERY_N=5
MANTRI_LOG_DETECTIONS=false
MANTRI_LOG_DETECTIONS_INTERVAL_S=2
MANTRI_LOG_EVENT_GATES=false

# Tap rule for monotrack and dual track (Release R-002, was the Release P shadow run):
# hold the last in-zone ladle box this long when detection drops, and need 2 s of
# white to open a tap. Names kept from the shadow run. 0 turns the hold off (0.8 s on).
MANTRI_MONOTRACK_SHADOW_LADLE_HOLD_SECONDS=60
MANTRI_MONOTRACK_SHADOW_TAPPING_ON_SECONDS=2


# Release Q-001 (DeepStream Wave 1): stage + smoke already check the Engines, so no
# trtexec loads on every start; preview copies at the live-stream rate; RTSP latency
# 500 -> 200 ms (all sources are local MediaMTX); detection log lines every 30 s
# (still well inside MANTRI_HEALTH_MODULE_MAX_STALE_S=90).
MANTRI_RTSP_LATENCY_MS=200

# Release Q-002: daily camera angle check at 10:00 IST (Jetson Fleet
# docs/camera-view-contract.md). Writes database/camera-view.json for the fleet
# agent and pictures under output/camera_view/. camera-4 is skipped while it is
# being replaced (inoculation moved to camera 3 in Release R).
MANTRI_CAMVIEW_ENABLED=true
MANTRI_CAMVIEW_DAILY_AT=10:00
MANTRI_CAMVIEW_SKIP=camera-4

# Release R: inoculation reads camera 3 (camera 4 is dead), so its frames are
# required again. Monotrack and dual track keep every 2nd camera frame (25 -> 12.5
# fps). Monotrack's heat-start gate counts frames, so 3/8 become 2/4 (about the
# same time). Dual track's own timings are in seconds and convert itself.
MANTRI_MONOTRACK_DROP_FRAME_INTERVAL=2
MANTRI_MONOTRACK_HEAT_START_ON_FRAMES=2
MANTRI_MONOTRACK_HEAT_START_OFF_FRAMES=4
MANTRI_DUAL_TRACK_ENABLED=true
MANTRI_DUAL_TRACK_DROP_FRAME_INTERVAL=2
MANTRI_DUAL_TRACK_LOG_DETECTIONS_INTERVAL_S=30

# Release R-004 (TEMPORARY): cameras 3 and 4 are both offline (camera 3 since
# 15:04 IST Oct 5), so inoculation has no frames and every activation failed
# the health gate. Inoculation stays enabled and resumes when camera 3 streams.
# Remove this in the next Release once camera 3 is back.
MANTRI_HEALTH_SKIP_INOCULATION_FRAMES=true
