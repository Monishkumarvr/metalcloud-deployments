# Non-secret Nipha settings, versioned with each Release (becomes the Release's site.env).
# Camera URLs are secrets: they live on the Device in persistent/secrets/nipha.env.
# IST as a POSIX TZ string: works without tzdata and without bind-mounting /etc/localtime.
TZ=IST-5:30
NIPHA_FPS=25
NIPHA_LIVE_FPS=5
NIPHA_WATCHDOG_GRACE_S=120
NIPHA_WATCHDOG_STALE_S=90
