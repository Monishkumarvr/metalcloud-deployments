# Non-secret Nipha settings, versioned with each Release (becomes the Release's site.env).
# Camera URLs are secrets: they live on the Device in persistent/secrets/nipha.env.
# IST as a POSIX TZ string: works without tzdata and without bind-mounting /etc/localtime.
TZ=IST-5:30
NIPHA_FPS=25
NIPHA_LIVE_FPS=5
# A camera sometimes refuses its RTSP session right after a restart and nvurisrcbin never
# reconnects; the watchdog restarts the process instead. Short enough that a restart
# lands inside the activation health window (2026-10-05: 007 rolled back before it did).
NIPHA_WATCHDOG_GRACE_S=60
NIPHA_WATCHDOG_STALE_S=45
# --mode furnace (used by Releases running nipha-furnace)
NIPHA_PYRO_INTERVAL=4
NIPHA_MELTING_STRIDE=5
NIPHA_HEAT_COLD_GAP_S=1800
# Melting: a pixel is hot if red-dominant (R > 180 and R > G,B + 5) or bright and warm
# (max(R,G,B) > 210 and R - B >= 30); sunlight, smoke and smears (neutral) never are.
# Melting turns ON when the 5 s median hot ratio stays above ON_RATIO for ON_S, and OFF
# when it stays at or below OFF_RATIO for OFF_S (20 min, so charging keeps it ON).
# Measured 2026-10-05: melting B 0.22-0.51, idle zones 0.00-0.01.
NIPHA_MELTING_ON_RATIO=0.15
NIPHA_MELTING_OFF_RATIO=0.05
NIPHA_MELTING_ON_S=15
NIPHA_MELTING_OFF_S=1200
NIPHA_HOT_RED_THRESHOLD=180
NIPHA_HOT_RED_MARGIN=5
NIPHA_HOT_WHITE_THRESHOLD=210
NIPHA_HOT_WARM_DELTA=30
# 1 = per-camera 1 Hz melting CSV in output/<camera>/ for tuning (on for the first days of 007).
NIPHA_MELTING_LOG=1
# Tapping/deslagging zones active only while their furnace is melting (the furnace
# services write the state to /live/melting; unknown = active). F: no melting zone.
NIPHA_ZONE_MELTING_GATE=1
NIPHA_ZONE_GATE_EXEMPT=F
# RTSP transport: 0 = UDP (default), 1 = TCP. TCP is set per service in compose (F34 only):
# with TCP on every camera (007, 2026-10-05) D03, D05 and F12 stopped after a few frames
# and never reconnected ("Could not write to resource"); F34 smears over UDP.
NIPHA_RTSP_TCP=0
# AGNI sync (nipha-sync): one record per heat per furnace to the AGNI API (MongoDB +
# dashboard), as on Pashupati. AGNI_HMAC_SECRET is only in the Device's secrets file.
AGNI_API_URL=http://ai-bakend-v2.ap-south-1.elasticbeanstalk.com/api/v1
AGNI_ENDPOINT=/agni
AGNI_CUSTOMER_ID=104
# Heats v3 (from Release 015): new sync_ids, so nothing collides with the records posted
# by Release 013 ("nipha") or the unposted v2 rebuild ("nipha2").
AGNI_SYNC_PREFIX=nipha3
# Zone gate: a tapping/deslagging piece counts only if its furnace was melting (a ladle
# from the next furnace brought into a zone for a temperature check is no tap there).
# F has no melting zone, so it is never gated.
AGNI_MELTING_GATE=1
AGNI_GATE_EXEMPT=F
# Tapping camera per furnace (camera_id); furnace names are "Furnace A" ... "Furnace F".
AGNI_CAMERAS=A=D03,B=D03,C=D03,D=D05,E=D05,F=D05
# Two shifts; the night shift keeps the date it started on.
AGNI_SHIFTS=A=08:30-20:30,B=20:30-08:30
SITE_UTC_OFFSET=+05:30
AGNI_FIRST_HEAT_NO=1
# One heat, several taps: a tap starting within 30 min after the heat's first tap ended
# (or within JOIN_GAP_S of its last piece: the same pour) belongs to it. A heat is posted
# once that window has passed.
HEAT_TAP_WINDOW_S=1800
JOIN_GAP_S=60
# Heat start = previous heat's last tap end + 1 s; after 3 h without a tap, the melting
# cold start when there is one.
HEAT_IDLE_GAP_S=10800
MIN_TAPPING_PIECE_S=10
MAX_HEAT_WAIT_S=1800
RETENTION_DAYS=30
HISTORY_LOOKBACK_S=21600
# Rebuild: a fresh state that goes live at the original go-live (2026-10-05 13:20:05 IST),
# so every heat since then is rebuilt with the v2 rules and renumbered from HEAT_0001.
# The old state (agni/) is kept as the record of what Release 013 sent; agni-v2 is the
# unposted rebuild without the zone gate.
STATE_DIR=/workspace/deepstream-nipha/state/agni-v3
SYNC_GO_LIVE_AT=1791186605
# 1 = write each heat to <STATE_DIR>/dry_run/ instead of posting (review before the old
# records are deleted and the rebuilt ones are posted).
SYNC_DRY_RUN=1
